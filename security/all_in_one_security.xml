<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_all_in_one" model="ir.module.category">
        <field name="name">All In One ERP</field>
        <field name="description">Access rights for All In One Module</field>
        <field name="sequence">15</field>
    </record>

    <record id="privilege_all_in_one" model="res.groups.privilege">
        <field name="name">All In One ERP</field>
        <field name="sequence">15</field>
        <field name="category_id" ref="module_category_all_in_one"/>
    </record>

    <record id="group_all_in_one_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_all_in_one"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_all_in_one_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_all_in_one"/>
        <field name="implied_ids" eval="[Command.link(ref('all_in_one.group_all_in_one_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('all_in_one.group_all_in_one_manager'))]"/>
    </record>
</odoo>