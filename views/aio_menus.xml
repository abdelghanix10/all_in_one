<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client Action for All In One OWL 3 App -->
    <record id="action_all_in_one_dashboard" model="ir.actions.client">
        <field name="name">All In One</field>
        <field name="tag">all_in_one.dashboard</field>
    </record>

    <!-- Root App Menu -->
    <menuitem id="menu_all_in_one_root"
              name="All In One"
              action="action_all_in_one_dashboard"
              sequence="1"
              groups="all_in_one.group_all_in_one_user"/>

    <!-- Extend Product Form with All In One Fields -->
    <record id="product_template_form_view_inherit_aio" model="ir.ui.view">
        <field name="name">product.template.form.inherit.all.in.one</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='to_weight']" position="after">
                <field name="aio_deduction_priority"/>
                <field name="aio_is_generic_price_btn"/>
                <field name="aio_tracked_card"/>
                <field name="aio_final_product_id" invisible="not purchase_ok"/>
            </xpath>
        </field>
    </record>
</odoo>